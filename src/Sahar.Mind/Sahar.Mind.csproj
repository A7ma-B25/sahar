<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Her brain's process (spec 0.14 §3): started by the engine on demand, exits when idle. No window. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Sahar.Mind</AssemblyName>
    <RootNamespace>Sahar.Mind</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sahar.Core\Sahar.Core.csproj" />
  </ItemGroup>
</Project>
