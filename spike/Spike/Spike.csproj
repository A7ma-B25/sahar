<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Throwaway spike: can a C# Native AOT app draw a smooth, click-through companion
    over the whole screen while staying light? Two drawing approaches, one exe:
      A = Windows.UI.Composition (the compositor animates; the app sleeps)
      B = SkiaSharp into a small per-pixel-alpha layered window (the app redraws)
    This code is deleted once the numbers are in.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>DeskCompanionSpike</AssemblyName>
    <RootNamespace>Spike</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Lets the project build on non-Windows machines too (compile checks only). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

</Project>
