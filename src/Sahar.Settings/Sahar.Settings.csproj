<Project Sdk="Microsoft.NET.Sdk">
  <!-- The settings app (0.12, plan 0.10c): a WebView2 page in a plain Win32 window. Not AOT; published self-contained
       single-file (the test build has no .NET runtime) into <engine dir>\Sahar.Settings with web\ beside it. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Sahar.Settings</AssemblyName>
    <RootNamespace>Sahar.Settings</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <ProjectReference Include="..\Sahar.Core\Sahar.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="web\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- Rubik (OFL), the engine's own static cuts 400/500/600: one copy in the repo, served from web\fonts. -->
    <Content Include="..\Sahar.Engine\assets\fonts\Rubik-*.ttf;..\Sahar.Engine\assets\fonts\OFL.txt" Link="web\fonts\%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <!-- Core API only (no WinForms/WPF): the package references its WinForms and WPF wrappers; drop them. -->
  <Target Name="SaharDropWebView2Wrappers" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.WinForms' or '%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>
