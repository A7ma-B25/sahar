<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Sahar.Engine</AssemblyName>
    <RootNamespace>Sahar.Engine</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Sahar's face (tools/art/app_icon.py): the exe, its shortcut, Settings → Apps and the tray (resource 32512). -->
    <ApplicationIcon>assets\sahar.ico</ApplicationIcon>
    <!-- Compiles on non-Windows machines too (compile checks only). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sahar.Core\Sahar.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Rubik (OFL, static instances cut by tools/fonts/make_rubik.py): the menu card's type, loaded from memory. -->
    <EmbeddedResource Include="assets\fonts\*.ttf" LogicalName="Sahar.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
